# Portal TCC — configuração
#
# Copie este arquivo para .env antes de subir o projeto:
#
#     cp .env.example .env
#
# Só existe UM valor que você precisa preencher: a chave do Google.
# Todo o resto já vem pronto e não precisa ser alterado.

# ---------------------------------------------------------------------------
# Google AI (Gemini)
# ---------------------------------------------------------------------------
# Necessária para o chatbot responder perguntas sobre os dados.
# Gere a sua gratuitamente em: https://aistudio.google.com/apikey
#
# O sistema sobe normalmente sem esta chave: você consegue enviar CSVs e
# ver os dados sendo processados e persistidos. Apenas o chat vai
# responder com uma mensagem avisando que a chave não está configurada.
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Modelo (opcional)
# ---------------------------------------------------------------------------
# Nada aqui precisa ser preenchido: sem estas linhas valem os padrões do
# backend/config.py. Descomente só para experimentar.
#
# Modelo do chat. Útil para voltar a um modelo anterior sem mexer no código,
# por exemplo se o padrão estiver indisponível.
#LLM_MODEL=gemini-3.7-flash
#
# Quanto o modelo raciocina antes de responder: low, medium ou high.
# `low` reduz a espera pelo primeiro token; `high` aprofunda a análise.
#LLM_THINKING_LEVEL=medium

# ---------------------------------------------------------------------------
# PostgreSQL / TimescaleDB
# ---------------------------------------------------------------------------
# Credenciais do banco que roda em container. Para uso local não há
# motivo para alterar — nada aqui fica exposto fora da sua máquina.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portaltcc
